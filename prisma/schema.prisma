generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Um squad = uma equipe de CFO as a Service com sua própria conta na plataforma.
// Todo dado de negócio (Task, ClientNote, MeetRecap, etc.) pertence a exatamente
// um Squad — isolamento entre squads é reforçado centralmente em src/lib/tenant-prisma.ts,
// não confiar em cada rota lembrar de filtrar manualmente.
model Squad {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id            String    @id @default(cuid())
  squadId       String
  role          String    @default("member") // "admin" (CFO — convida/remove gente, configura integrações do squad) | "member"
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  cargo         String?
  onboardingCompletedAt DateTime? // null = ainda não viu/concluiu o onboarding animado no 1o login
  squad         Squad     @relation(fields: [squadId], references: [id])
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  comments      TaskComment[]
  passwordResetTokens PasswordResetToken[]
  tratativas         Tratativa[] @relation("TratativaResponsavel")
  createdTratativas  Tratativa[] @relation("TratativaCreatedBy")
  uploadedRecaps     MeetRecap[] @relation("UploadedRecaps")
  assistantMessages  AssistantMessage[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([squadId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Convite de membro pro squad — deliberadamente SEM relação/FK pro User (ao
// contrário de PasswordResetToken, que cascade-deleta junto quando o membro é
// removido). Assim o histórico ("quem convidamos, quem aceitou, quem não")
// sobrevive mesmo que a pessoa seja removida depois. Status é sempre computado
// na leitura a partir de acceptedAt/expiresAt (ver GET /api/invites), não
// guardado como campo — evita ficar dessincronizado.
model Invite {
  id            String    @id @default(cuid())
  squadId       String
  email         String
  name          String?
  role          String
  invitedByName String?
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([squadId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  squadId     String
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  assigneeId  String?
  createdById String
  source      String    @default("manual")
  sourceRef   String?
  client      String?
  deliverTo   String?
  meetingTitle String? // assunto da reunião de origem (Meet Recap ou n8n), quando houver
  meetingDate  DateTime? // data da reunião de origem
  clientDraftCreatedAt DateTime? // quando o rascunho de cobrança pro cliente foi criado (evita duplicar)
  sortOrder   Float     @default(0)
  recurrence  String?   // "weekly" | "biweekly" | "monthly"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assignee    User?          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy   User           @relation("CreatedTasks", fields: [createdById], references: [id])
  comments    TaskComment[]
  subtasks    Subtask[]
  activities  TaskActivity[]
  links       TaskLink[]
  recapSuggestion RecapSuggestion?
  externalSuggestion ExternalSuggestion?

  @@index([assigneeId])
  @@index([status])
  @@index([client])
  @@index([updatedAt])
  @@index([squadId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Float    @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userName  String?
  type      String // "created" | "status" | "assignee" | "due_date" | "priority" | "title" | "recurrence"
  detail    String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  label     String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Notification {
  id        String    @id @default(cuid())
  squadId   String
  userId    String
  type      String // "assigned" | "mention" | "comment" | "recap"
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@index([squadId])
}

model ClientNote {
  id                String    @id @default(cuid())
  squadId           String
  client            String
  notes             String?
  contacts          String?
  status            String    @default("ativo") // "ativo" | "pausado" | "encerrado"
  oxyStage          String    @default("nao_iniciado") // "nao_iniciado" | "em_validacao" | "em_implantacao" | "implantacao_interrompida" | "ativo"
  importType        String? // "manual" | "automatica" | "automatica_manual"
  lastDataUpdate    DateTime?
  oxyPendencies     String? // "o que" da pendência
  pendencyWho       String? // "quem" é responsável pela pendência
  erp               String? // nome do ERP usado pelo cliente
  accessMode        String? // modo de acesso ao ERP/Oxy
  updateFrequency   String? // frequência de atualização dos dados (ex: "toda quarta")
  updateResponsible String? // responsável por manter os dados atualizados
  routineWhat       String? // rotina recorrente com o cliente: o que é feito
  routineWho        String? // rotina recorrente: quem faz
  routineWhen       String? // rotina recorrente: quando
  healthStatus      String    @default("verde") // "verde" | "amarelo" | "vermelho" — semáforo de saúde da conta
  onboardingStartAt DateTime? // D+0: data do 1º pagamento, âncora dos marcos de onboarding
  cfoAllocatedAt    DateTime? // marco D+2
  kickoffScheduledAt DateTime? // marco D+3
  kickoffDoneAt     DateTime? // marco D+7
  setupDoneAt       DateTime? // marco D+30 (Setup + Comitê de Estruturação)
  diagnosticDoneAt  DateTime? // marco D+60 (Diagnóstico + Comitê de Diagnóstico) — mesma data da Etapa 4 (Apresentação final)
  oxyIntegratedAt   DateTime? // marco D+90 (Oxy + início do Comitê Estratégico Mensal)
  diagnosticoHandoffAt   DateTime? // Diagnóstico Etapa 0: handoff do Setup
  diagnosticoIntakeAt    DateTime? // Diagnóstico Etapa 1: intake complementar (assíncrono)
  diagnosticoIntakePendente String? // o que ainda falta pedir (Balanço, DFC, endividamento, Serasa, protestos, contrato social, dado de mercado...)
  diagnosticoAnaliseAt   DateTime? // Diagnóstico Etapa 2: análise e montagem (DRE, DFC, NCG/CDG/Tesouraria)
  diagnosticoValidacaoAt DateTime? // Diagnóstico Etapa 3: validação com o cliente (na semanal)
  updatedAt         DateTime  @updatedAt

  @@unique([squadId, client])
  @@index([status])
  @@index([oxyStage])
  @@index([healthStatus])
  @@index([squadId])
}

// Acessos ao ERP/Oxy do cliente — vira lista (não campo único em ClientNote) porque
// tem cliente com mais de uma empresa/CNPJ, cada uma com seu próprio ERP e login.
model ClientLogin {
  id         String   @id @default(cuid())
  squadId    String
  client     String // nome do cliente, mesma string usada em Task/CalendarEvent/ClientNote
  empresa    String // razão social/nome da empresa (distingue quando o cliente tem mais de uma)
  erp        String?
  accessMode String? // como acessar: login/senha compartilhado, API, acesso remoto…
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([client])
  @@index([squadId])
}

model SetupMeeting {
  id            String    @id @default(cuid())
  squadId       String
  client        String
  code          String // "R1" | "R2" | "R3" | "R4"
  scheduledAt   DateTime?
  completedAt   DateTime?
  participants  String?
  recordingUrl  String?
  transcriptUrl String?
  nextSteps     String?
  updatedAt     DateTime  @updatedAt

  @@unique([squadId, client, code])
  @@index([client])
  @@index([squadId])
}

model Tratativa {
  id                      String    @id @default(cuid())
  squadId                 String
  client                  String
  tipo                    String // "preventiva" | "reativa"
  motivo                  String
  descricao               String?
  satisfacao              String?
  problemaNaOxy           Boolean   @default(false)
  status                  String    @default("triagem") // "triagem" | "em_tratativa" | "plano_de_acao" | "concluida"
  responsavelId           String?
  dataPrevistaFinalizacao DateTime?
  planoDeAcao             String?
  desfecho                String? // "recuperado" | "churn" | "downsell" | "mudanca_escopo" | "desistencia"
  churnMotivo             String?
  churnData               DateTime?
  createdById             String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  responsavel User? @relation("TratativaResponsavel", fields: [responsavelId], references: [id])
  createdBy   User  @relation("TratativaCreatedBy", fields: [createdById], references: [id])

  @@index([client])
  @@index([status])
  @@index([squadId])
}

model MeetRecap {
  id             String    @id @default(cuid())
  squadId        String
  subject        String
  body           String
  gmailId        String? // null quando source = "manual" (não veio de um e-mail)
  source         String    @default("gmail") // "gmail" | "manual" (upload de transcrição em /recaps)
  uploadedById   String? // quem fez o upload manual; null pros recaps sincronizados do Gmail
  uploadedBy     User?     @relation("UploadedRecaps", fields: [uploadedById], references: [id])
  client         String?
  processedAt    DateTime?
  suggestedTasks String?
  suggestions    RecapSuggestion[]
  createdAt      DateTime  @default(now())

  @@unique([squadId, gmailId])
  @@index([processedAt])
  @@index([squadId])
}

model RecapSuggestion {
  id          String    @id @default(cuid())
  recapId     String
  index       Int // ordem de exibição dentro da leva de sugestões
  title       String // como a IA sugeriu originalmente (referência pra medir edição)
  description String?
  assignee    String?
  priority    String?
  dueDate     DateTime?
  status      String    @default("pending") // "pending" | "accepted" | "edited" | "rejected" | "superseded" | "duplicate"
  duplicateNote String? // preenchido quando status = "duplicate": explica com o que bateu
  taskId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recap MeetRecap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  task  Task?     @relation(fields: [taskId], references: [id])

  @@index([recapId])
  @@index([status])
}

// Sugestão de tarefa vinda de uma fonte externa (ex.: workflow n8n).
// Igual à RecapSuggestion no espírito (fica pendente até alguém aceitar/descartar
// em /sugestoes-ia), mas sem depender de um MeetRecap.
model ExternalSuggestion {
  id          String    @id @default(cuid())
  squadId     String
  source      String // "n8n" (aberto pra outras origens no futuro)
  sourceRef   String?
  title       String
  description String?
  client      String?
  priority    String?
  dueDate     DateTime?
  status      String    @default("pending") // "pending" | "accepted" | "edited" | "rejected" | "duplicate"
  duplicateNote String? // preenchido quando status = "duplicate": explica com o que bateu
  meetingTitle String? // assunto da reunião de origem, se o workflow mandar
  meetingDate  DateTime? // data da reunião de origem, se o workflow mandar
  taskId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task? @relation(fields: [taskId], references: [id])

  @@index([status])
  @@index([source])
  @@index([squadId])
}

model Setting {
  squadId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([squadId, key])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Histórico do assistente de IA flutuante, por pessoa — permite ele lembrar de
// conversas anteriores em vez de começar do zero a cada recarregamento da página.
model AssistantMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PlatformLog {
  id        String   @id @default(cuid())
  squadId   String? // fica nullable pra sempre — algumas linhas são de sistema/cron, não de um squad específico
  level     String   @default("info")
  category  String
  message   String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([level])
  @@index([squadId])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  squadId      String
  googleId     String
  title        String
  client       String
  startAt      DateTime
  endAt        DateTime
  briefingSent Boolean  @default(false)
  meetingType  String? // "semanal" | "comite" | "kickoff" | "setup" | "interno" — extraído do título "| <Tipo>"
  temperature  String? // "otimo" | "bom" | "atencao" | "critico" — clima da reunião, preenchido depois
  nextSteps    String? // próximos passos validados pós-reunião
  attendanceConfirmed Boolean @default(false) // presença confirmada/corrigida
  registroConferido   Boolean @default(false) // registro (gravação/transcrição) conferido
  attendeeUserIds     String[] @default([]) // User.id de quem do squad participa (e-mail do convidado casado com User.email), pro filtro por pessoa em /calendar
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([squadId, googleId])
  @@index([startAt])
  @@index([client])
  @@index([squadId])
}

model FechamentoMensal {
  id                    String   @id @default(cuid())
  squadId               String
  client                String
  year                  Int
  month                 Int // 1-12
  comiteRealizado       Boolean  @default(false)
  rebalanceamentoFeito  Boolean  @default(false)
  conciliacaoOk         Boolean  @default(false)
  cpCrFechados          Boolean  @default(false)
  pendenciasAnotadas    String?
  maturidade            String? // avaliação livre da maturidade do fechamento
  healthReviewedAt      DateTime?
  updatedAt             DateTime @updatedAt

  @@unique([squadId, client, year, month])
  @@index([client])
  @@index([squadId])
}

// Rotinas automatizadas fora do app (hoje rodam como tarefas agendadas do
// Claude/Cowork: extração de relatório no ERP do cliente + upload na Oxy
// CFO Hub). Este modelo só guarda o status reportado por elas — a execução
// em si acontece fora do tarefasgestao.
model Automation {
  id            String    @id @default(cuid())
  squadId       String
  key           String // ex: "getconnect-oxy", "babyland-oxy", "zedoflor-lembrete"
  name          String // ex: "GetConnect → Oxy CFO Hub"
  client        String? // nome do cliente, casa com ClientNote.client quando existir
  scheduleLabel String // ex: "Toda quarta, 14h" — texto livre, só pra exibição
  enabled       Boolean   @default(true) // controlado pelo painel /automacoes
  lastRunAt     DateTime?
  lastStatus    String? // "success" | "error"
  lastSummary   String?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  runs     AutomationRun[]
  commands AutomationCommand[]

  @@unique([squadId, key])
  @@index([client])
  @@index([squadId])
}

// Histórico de execuções reportadas pela rotina externa (uma linha por rodada).
model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  status       String // "success" | "error"
  summary      String?
  detail       String?
  startedAt    DateTime?
  finishedAt   DateTime  @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([finishedAt])
}

// Fila de comandos vindos do painel /automacoes ("Rodar agora", "Pausar",
// "Reativar"). Uma tarefa agendada do Claude (bridge) faz polling desses
// comandos pendentes e executa do lado de fora, depois marca como concluído.
model AutomationCommand {
  id            String    @id @default(cuid())
  automationId  String
  type          String // "trigger" | "pause" | "resume"
  status        String    @default("pending") // "pending" | "done" | "failed"
  requestedById String?
  resultDetail  String?
  requestedAt   DateTime  @default(now())
  processedAt   DateTime?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, status])
  @@index([status])
}
